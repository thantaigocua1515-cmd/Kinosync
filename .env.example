# ---------------------------------------------------------------------------
# Kinosync — biến môi trường (server-side, KHÔNG đặt tiền tố NEXT_PUBLIC_)
# Sao chép tệp này thành .env.local khi chạy ở máy, và khai báo trên Vercel.
# ---------------------------------------------------------------------------

# Bắt buộc: khoá Google AI Studio dùng cho giọng đọc (TTS) và nhận dạng lời nói.
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Tuỳ chọn: đổi model giọng đọc nếu khoá của bạn không có model mặc định.
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Tuỳ chọn: đổi model nhận dạng lời nói cho trình dựng thủ công.
# GEMINI_TRANSCRIBE_MODEL="gemini-2.5-flash"

# Tuỳ chọn: đổi máy chủ nguồn truyện (mặc định https://truyenok.online).
# TRUYENOK_API_BASE="https://truyenok.online"

# Tuỳ chọn: số đoạn giọng đọc xử lý song song ở trình duyệt (1–6).
# NEXT_PUBLIC_TTS_CONCURRENCY="3"
